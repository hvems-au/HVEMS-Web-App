# ---------------------------------------------------------------------------
# HVEMS environment template. Copy to apps/web/.env.local for local work.
# NEVER commit real values. Secrets live in the hosting provider's secret store.
# ---------------------------------------------------------------------------

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://anvqykllajezwaasguqp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_UuPRKOfwkeTZi5vGzwhYHg_fzMjNRCU
# HVEMS's helpdesk contact form URL or a mailto: address (SoW §11.2). Empty hides the support link.
NEXT_PUBLIC_SUPPORT_URL=

# Portal hosts (ADR-009). Each portal has its own sign-in and session; proxy.ts
# serves only that portal's routes on each host. Production uses HVEMS's domain,
# e.g. admin.hvems.com.au. Add every host's /auth/callback to the Supabase Auth
# redirect allow-list WITH a trailing ** (the links carry ?next=…), e.g.
# http://company.localhost:3000/auth/callback**
ADMIN_HOST=admin.localhost:3000
COMPANY_HOST=company.localhost:3000
MARKET_HOST=market.localhost:3000
PROVIDER_HOST=provider.localhost:3000
DRIVER_HOST=driver.localhost:3000
# Production: COMPANY_HOST=portal.hvems.com.au, PROVIDER_HOST=provider.hvems.com.au,
#   DRIVER_HOST=operator.hvems.com.au, ADMIN_HOST=admin.hvems.com.au, MARKET_HOST=market.hvems.com.au
# Development site: the same with a dev- prefix (dev-portal.hvems.com.au, dev-provider.hvems.com.au, ...)

# Server-only secrets — set in the deployment secret store, never NEXT_PUBLIC_*
SUPABASE_SECRET_KEY=
# Optional: signs portal handoff tokens. If empty, a key is derived from SUPABASE_SECRET_KEY.
PORTAL_HANDOFF_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_PROVIDER_API_KEY=
SENTRY_DSN=
